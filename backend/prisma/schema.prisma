generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Niche {
  id              String         @id @default(cuid())
  name            String         @unique
  category        String         @default("Services")
  keywords        String         // JSON array or comma separated
  synonyms        String         // JSON array or comma separated
  searchOperators String?        // Custom operators JSON
  isCustom        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  searches        Search[]
}

model Search {
  id              String         @id @default(cuid())
  name            String
  nicheId         String?
  niche           Niche?         @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  nicheName       String
  locations       String         // JSON array or comma separated
  options         String?        // JSON of search toggles (includeInstagram, searchDepth, etc.)
  totalFound      Int            @default(0)
  createdAt       DateTime       @default(now())
  queries         SearchQuery[]
}

model SearchQuery {
  id              String         @id @default(cuid())
  searchId        String
  search          Search         @relation(fields: [searchId], references: [id], onDelete: Cascade)
  queryText       String
  operatorType    String         @default("standard")
  resultsCount    Int            @default(0)
  createdAt       DateTime       @default(now())
}

model Lead {
  id                     String               @id @default(cuid())
  normalizedIdentityKey  String               @unique
  businessName           String
  niche                  String
  location               String
  description            String?
  websiteStatus          String               @default("Website Not Found") // "Website Found" | "Website Not Found" | "Website Unclear"
  websiteUrl             String?
  instagram              String?
  facebook               String?
  phone                  String?
  email                  String?
  googleBusinessUrl      String?
  sourceUrl              String?
  searchQuery            String?
  discoverySource        String               @default("google_maps")
  googlePlaceId          String?
  googleCid              String?
  googleMapsUrl          String?
  address                String?
  rating                 Float?
  reviewsCount           Int?
  category               String?
  latitude               Float?
  longitude              Float?
  searchProvider         String?              // e.g. "MockSearchProvider", "GoogleSearchProvider", "SerpApiProvider", "SerpApiMapsProvider"
  validationStatus       String               @default("POTENTIAL") // "VERIFIED" | "POTENTIAL" | "INVALID"
  validationConfidence   Int                  @default(50)          // 0-100
  isDemo                 Boolean              @default(false)
  evidence               String?              // JSON array of EvidenceItem
  fieldEvidence          String?              // JSON map of FieldEvidenceItem records
  urlValidations         String?              // JSON map of URL validation records
  contactVerifications   String?              // JSON map of contact verification statuses
  opportunityScore       Int                  @default(0) // 0-100
  scoreTier              String               @default("Low") // "Very High" | "High" | "Medium" | "Low"
  scoreReason            String?
  status                 String               @default("New") // "New" | "Contacted" | "Interested" | "Not Interested" | "Client" | "Closed"
  notes                  String?
  demoGenerated          Boolean              @default(false)
  discoveredAt           DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  contacts               LeadContact[]
  socialProfiles         LeadSocialProfile[]
  statusHistory          LeadStatusHistory[]
  websiteDemoPrompts     WebsiteDemoPrompt[]
  outreachMessages       OutreachMessage[]
}

model LeadContact {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   // "phone" | "email"
  value       String
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model LeadSocialProfile {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  platform    String   // "instagram" | "facebook" | "tiktok" | "google_business"
  url         String
  username    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model LeadStatusHistory {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus   String?
  newStatus   String
  note        String?
  changedAt   DateTime @default(now())
}

model WebsiteDemoPrompt {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prompt      String
  createdAt   DateTime @default(now())
}

model OutreachMessage {
  id                        String   @id @default(cuid())
  leadId                    String
  lead                      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  style                     String   // "Friendly" | "Professional" | "Direct" | "Casual" | "Short"
  language                  String   @default("en") // "en" | "pt"
  messageText               String
  demoGeneratedAtGeneration Boolean  @default(false)
  createdAt                 DateTime @default(now())
}

